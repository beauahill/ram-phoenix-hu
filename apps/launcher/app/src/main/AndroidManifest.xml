<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <permission android:name="com.ramphoenix.launcher.permission.APPEARANCE" android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Google Maps tiles -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="com.ramphoenix.camera.permission.REVERSE_MONITOR" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- GPS: map follow + speed widget (until canbus speed is pinned) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.RamLauncher">

        <service android:name=".RecoveryService" android:exported="false" />
        <receiver android:name=".RecoveryReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Google Maps SDK key, injected from local.properties at build time (see app/build.gradle) -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <uses-library android:name="org.apache.http.legacy" android:required="false" />

        <provider android:name=".AppearanceProvider"
            android:authorities="com.ramphoenix.launcher.appearance"
            android:exported="true" android:grantUriPermissions="false"
            android:permission="com.ramphoenix.launcher.permission.APPEARANCE" />
        <activity android:name=".AppearanceActivity" android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize" />

        <activity android:name=".PaneWindowA" android:exported="false"
            android:taskAffinity="com.ramphoenix.launcher.pane.a" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".PaneWindowB" android:exported="false"
            android:taskAffinity="com.ramphoenix.launcher.pane.b" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />
        <activity android:name=".ExternalWindowActivity" android:exported="false"
            android:taskAffinity="com.ramphoenix.launcher.external" android:excludeFromRecents="true"
            android:resizeableActivity="true" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" />

        <!-- HOME: the dashboard -->
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Full-screen climate page, from the card or the app drawer -->
        <activity
            android:name=".ClimateActivity"
            android:exported="true"
            android:label="@string/climate_app"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Maintenance tracker, from the vehicle card SERVICE line or the app drawer -->
        <activity
            android:name=".MaintenanceActivity"
            android:exported="true"
            android:label="@string/maint_app"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MaintenanceEditorActivity" android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity android:name=".SuspensionActivity" android:exported="false"
            android:screenOrientation="portrait" android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- All-apps grid, opened from the dock -->
        <activity
            android:name=".AppDrawerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <!-- Needed so MediaSessionManager will hand us the active media sessions
             (Spotify, radio, music). Enable with:
             adb shell cmd notification allow_listener com.ramphoenix.launcher/.MediaListenerService -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
