<?xml version="1.0" encoding="utf-8"?>
<!-- Phoenix dashboard — CarPlay-style home for the portrait 1080x1920 panel.
     Status row + dock on top. Below that, one of two layouts (toggle in the
     status row, persisted):
       FULL  — map, now-playing and drive gauges stacked, filling the screen.
       SPLIT — two 50/50 landscape panes, each showing whichever widget (or app)
               its own picker selects.
     The widgets themselves (layout/widget_*.xml) are inflated once and moved
     between the FULL slots and the panes. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_base">

    <ImageView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_wallpaper"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== status row ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/clock_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:00 am"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/clock_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Day, Mon 0"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/status_outside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/no_data"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btn_layout"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:padding="7dp"
                android:background="@drawable/glass_circle"
                android:src="@drawable/ic_layout_split"
                android:contentDescription="@string/layout_toggle"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/btn_settings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="7dp"
                android:background="@drawable/glass_circle"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- ===== dock (buttons built in code) ===== -->
        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:background="@drawable/glass_card" />

        <!-- ===== content: FULL or SPLIT ===== -->
        <FrameLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/full_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                <FrameLayout
                    android:id="@+id/slot_full_map"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="3.2" />
                <FrameLayout
                    android:id="@+id/slot_full_media"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1.7"
                    android:layout_marginTop="12dp" />
                <FrameLayout
                    android:id="@+id/slot_full_drive"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2.8"
                    android:layout_marginTop="12dp" />
                <FrameLayout
                    android:id="@+id/slot_full_climate"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="2.4"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/split_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">
                <FrameLayout
                    android:id="@+id/pane_a"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
                <FrameLayout
                    android:id="@+id/pane_b"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
