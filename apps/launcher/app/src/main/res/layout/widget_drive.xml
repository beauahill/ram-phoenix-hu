<?xml version="1.0" encoding="utf-8"?>
<!-- Air Lift pressure and its compact control shortcut are part of the readings. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drive_row"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <com.ramphoenix.launcher.VehicleCardView
        android:id="@+id/vehicle_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp" />
</FrameLayout>
