<?xml version="1.0" encoding="utf-8"?>
<!-- "App" content for a SPLIT pane: pick an app and it is launched into this
     half's screen bounds (freeform window). The running app is shown in a strip
     at the top with an Open button; the grid stays for switching. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/run_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp"
            android:visibility="gone">
            <ImageView
                android:id="@+id/run_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/run_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/btn_open"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:background="@drawable/glass_tile_selector"
                android:text="@string/open"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/pick_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="4dp"
            android:text="@string/pick_app_hint"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-medium" />

        <TextView android:id="@+id/window_setup" android:layout_width="match_parent"
            android:layout_height="48dp" android:gravity="center_vertical"
            android:text="Enable split app windows" android:textColor="@color/text_primary"
            android:textSize="14sp" android:visibility="gone" />

        <GridView
            android:id="@+id/pane_app_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:numColumns="5"
            android:stretchMode="columnWidth"
            android:scrollbars="none"
            android:listSelector="@android:color/transparent" />
    </LinearLayout>
</FrameLayout>
