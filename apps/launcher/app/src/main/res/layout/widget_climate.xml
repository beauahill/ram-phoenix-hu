<?xml version="1.0" encoding="utf-8"?>
<!-- Climate card, laid out after Beau's reference (VW-style, 2026-10-25):
     header: power, title/status, rear defrost, heated wheel
     row 1 : square tiles  AUTO · DEFROST · FEET+DEF · FEET · FACE/FEET · FACE · RECIRC · MAX A/C · A/C
     row 2 : fan slider
     row 3 : seat heat/vent (L)  −  temp  +   SYNC   −  temp  +  seat vent/heat (R)
     Driven by ClimateWidget; ids are the contract. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/climate_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView style="@style/ClimateRound" android:id="@+id/cl_power" android:layout_marginStart="0dp" android:src="@drawable/ic_m_power_settings_new_sm" android:contentDescription="@string/cl_power" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/climate"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/climate_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:letterSpacing="0.12" />
        <ImageView style="@style/ClimateRound" android:id="@+id/cl_rdef"  android:src="@drawable/ic_m_windshield_defrost_rear_sm"  android:contentDescription="@string/cl_rdef" />
        <ImageView style="@style/ClimateRound" android:id="@+id/cl_wheel" android:src="@drawable/ic_m_steering_wheel_heat_sm" android:contentDescription="@string/cl_wheel" />
    </LinearLayout>

    <!-- row 1: tiles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView style="@style/ClimateTile" android:id="@+id/cl_auto"          android:drawableTop="@drawable/ic_m_mode_fan"     android:text="@string/cl_auto" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_fdef" android:src="@drawable/ic_m_windshield_defrost_front" android:contentDescription="@string/cl_fdef" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_mode_feetdef" android:src="@drawable/ic_m_car_defrost_low_left" android:contentDescription="@string/cl_feetdef" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_mode_feet" android:src="@drawable/ic_m_car_fan_low_left" android:contentDescription="@string/cl_feet" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_mode_facefeet" android:src="@drawable/ic_m_car_fan_low_mid_left" android:contentDescription="@string/cl_facefeet" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_mode_face" android:src="@drawable/ic_m_car_fan_mid_left" android:contentDescription="@string/cl_face" />
        <ImageView style="@style/ClimateTileImg" android:id="@+id/cl_recirc" android:src="@drawable/ic_m_car_fan_recirculate" android:contentDescription="@string/cl_recirc" />
        <TextView style="@style/ClimateTile" android:id="@+id/cl_acmax"         android:text="@string/cl_acmax_2line" android:textSize="11sp" android:maxLines="2" android:lineSpacingExtra="-2dp" />
        <TextView style="@style/ClimateTile" android:id="@+id/cl_ac"            android:drawableTop="@drawable/ic_m_ac_unit"       android:text="@string/cl_ac" />
    </LinearLayout>

    <!-- row 2: fan slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/climate_slider_bg">
        <ImageView android:id="@+id/cl_fan_dn" android:layout_width="24dp" android:layout_height="24dp" android:padding="5dp" android:src="@drawable/ic_m_mode_fan_sm" android:contentDescription="@string/minus" />
        <SeekBar
            android:id="@+id/cl_fan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:max="7"
            android:progress="0"
            android:progressDrawable="@drawable/climate_slider_track"
            android:thumb="@drawable/climate_slider_thumb"
            android:splitTrack="false" />
        <ImageView android:id="@+id/cl_fan_up" android:layout_width="28dp" android:layout_height="28dp" android:padding="3dp" android:src="@drawable/ic_m_mode_fan" android:contentDescription="@string/plus" />
    </LinearLayout>

    <!-- row 3: seats | temps | sync -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView style="@style/ClimateTile" android:id="@+id/cl_heat_l" android:background="@null" android:drawableTop="@drawable/ic_m_seat_heat_left" android:textSize="8sp" android:letterSpacing="0.08" android:drawablePadding="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
        <TextView style="@style/ClimateTile" android:id="@+id/cl_vent_l" android:background="@null" android:drawableTop="@drawable/ic_m_seat_cool_left" android:textSize="8sp" android:letterSpacing="0.08" android:drawablePadding="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#22FFFFFF" />
        <TextView style="@style/ClimateStepper" android:id="@+id/cl_tl_dn" android:layout_marginStart="8dp" android:text="@string/minus" />
        <LinearLayout style="@style/ClimateValueBox" android:layout_weight="1.9">
            <TextView android:id="@+id/cl_temp_l" style="@style/ClimateValueText" android:textSize="24sp" android:text="@string/no_data" />
            <TextView style="@style/ClimateValueLabel" android:text="@string/cl_driver" />
        </LinearLayout>
        <TextView style="@style/ClimateStepper" android:id="@+id/cl_tl_up" android:text="@string/plus" />
        <TextView
            android:id="@+id/cl_sync"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center"
            android:background="@drawable/glass_tile_selector"
            android:text="@string/cl_dual"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:fontFamily="sans-serif-medium" />
        <TextView style="@style/ClimateStepper" android:id="@+id/cl_tr_dn" android:text="@string/minus" />
        <LinearLayout style="@style/ClimateValueBox" android:layout_weight="1.9">
            <TextView android:id="@+id/cl_temp_r" style="@style/ClimateValueText" android:textSize="24sp" android:text="@string/no_data" />
            <TextView style="@style/ClimateValueLabel" android:text="@string/cl_passenger" />
        </LinearLayout>
        <TextView style="@style/ClimateStepper" android:id="@+id/cl_tr_up" android:layout_marginEnd="8dp" android:text="@string/plus" />
        <View android:layout_width="1dp" android:layout_height="match_parent" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:background="#22FFFFFF" />
        <TextView style="@style/ClimateTile" android:id="@+id/cl_vent_r" android:background="@null" android:drawableTop="@drawable/ic_m_seat_cool_right" android:textSize="8sp" android:letterSpacing="0.08" android:drawablePadding="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
        <TextView style="@style/ClimateTile" android:id="@+id/cl_heat_r" android:background="@null" android:drawableTop="@drawable/ic_m_seat_heat_right" android:textSize="8sp" android:letterSpacing="0.08" android:drawablePadding="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
    </LinearLayout>
</LinearLayout>
