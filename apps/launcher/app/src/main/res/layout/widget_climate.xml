<?xml version="1.0" encoding="utf-8"?>
<!-- Climate card (Beau, 2026-10-25: icons and plain labels, seat controls obvious).
     Row 1: system toggles. Row 2: driver zone | passenger zone, each with seat
     heat / seat vent, temperature. Row 3: fan, then the four air-distribution
     modes. Chip ids are unchanged; ClimateWidget drives state and sends. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/climate_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/climate"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.16"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:id="@+id/climate_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- row 1: system toggles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_power"  android:drawableTop="@drawable/cl_pa_power"  />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_auto"   android:drawableTop="@drawable/cl_pa_auto"   />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_ac"     android:drawableTop="@drawable/cl_pa_ac"     />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_acmax"  android:drawableTop="@drawable/cl_pa_maxac"  />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_recirc" android:drawableTop="@drawable/cl_pa_recirc" />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_sync"   android:drawableTop="@drawable/cl_pa_sync"   />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_fdef"   android:drawableTop="@drawable/cl_pa_fdef"   />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_rdef"   android:drawableTop="@drawable/cl_pa_rdef"   />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_wheel"  android:drawableTop="@drawable/cl_pa_wheel"  />
    </LinearLayout>

    <!-- row 2: driver | passenger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_heat_l" android:drawableTop="@drawable/pa_seatheat_l0" android:layout_weight="1.15" />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_vent_l" android:drawableTop="@drawable/pa_seatvent_l0" android:layout_weight="1.15" />
        <TextView style="@style/ClimateChip" android:id="@+id/cl_tl_dn"  android:text="@string/minus" android:textSize="24sp" android:layout_weight="0.8" />
        <LinearLayout style="@style/ClimateValueBox">
            <TextView android:id="@+id/cl_temp_l" style="@style/ClimateValueText" android:text="@string/no_data" />
            <TextView style="@style/ClimateValueLabel" android:text="@string/cl_driver" />
        </LinearLayout>
        <TextView style="@style/ClimateChip" android:id="@+id/cl_tl_up"  android:text="@string/plus" android:textSize="24sp" android:layout_weight="0.8" />
        <View android:layout_width="8dp" android:layout_height="match_parent" />
        <TextView style="@style/ClimateChip" android:id="@+id/cl_tr_dn"  android:text="@string/minus" android:textSize="24sp" android:layout_weight="0.8" />
        <LinearLayout style="@style/ClimateValueBox">
            <TextView android:id="@+id/cl_temp_r" style="@style/ClimateValueText" android:text="@string/no_data" />
            <TextView style="@style/ClimateValueLabel" android:text="@string/cl_passenger" />
        </LinearLayout>
        <TextView style="@style/ClimateChip" android:id="@+id/cl_tr_up"  android:text="@string/plus" android:textSize="24sp" android:layout_weight="0.8" />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_vent_r" android:drawableTop="@drawable/pa_seatvent_l0" android:layout_weight="1.15" />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_heat_r" android:drawableTop="@drawable/pa_seatheat_l0" android:layout_weight="1.15" />
    </LinearLayout>

    <!-- row 3: fan + air distribution -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.15"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">
        <TextView style="@style/ClimateChip" android:id="@+id/cl_fan_dn" android:text="@string/minus" android:textSize="24sp" android:layout_weight="0.8" />
        <LinearLayout style="@style/ClimateValueBox" android:layout_weight="2.4">
            <TextView android:id="@+id/cl_fan" style="@style/ClimateValueText" android:text="@string/no_data" android:textSize="15sp" android:letterSpacing="0.1" android:drawableTop="@drawable/pa_fan0" android:drawablePadding="2dp" />
        </LinearLayout>
        <TextView style="@style/ClimateChip" android:id="@+id/cl_fan_up" android:text="@string/plus" android:textSize="24sp" android:layout_weight="0.8" />
        <View android:layout_width="8dp" android:layout_height="match_parent" />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_mode_face"     android:drawableTop="@drawable/cl_pa_face"      />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_mode_facefeet" android:drawableTop="@drawable/cl_pa_facefeet"   />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_mode_feet"     android:drawableTop="@drawable/cl_pa_feet"     />
        <TextView style="@style/ClimateIconChip" android:id="@+id/cl_mode_feetdef"  android:drawableTop="@drawable/cl_pa_feetdef" />
    </LinearLayout>
</LinearLayout>
