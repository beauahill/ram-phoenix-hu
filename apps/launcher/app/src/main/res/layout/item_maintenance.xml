<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:background="@drawable/glass_card"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/mi_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="17sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/mi_interval" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <TextView android:id="@+id/mi_last" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_tertiary" android:textSize="12sp" />
    </LinearLayout>
    <TextView android:id="@+id/mi_due" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp" android:gravity="end" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
    <ImageView android:id="@+id/mi_done" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/ic_m_check" android:background="@drawable/glass_circle" android:contentDescription="@string/maint_done" />
</LinearLayout>
