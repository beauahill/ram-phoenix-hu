<?xml version="1.0" encoding="utf-8"?>
<!-- Now-playing card. Art is square and fills the card height, so the same
     view works at the small FULL-mode size and the large SPLIT-pane size
     (MediaWidget.setLarge scales the text and buttons). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <com.ramphoenix.launcher.SquareImageView
        android:id="@+id/media_art"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_media_fallback"
        android:background="@drawable/glass_tile"
        android:contentDescription="@null" />

    <LinearLayout
        android:id="@+id/media_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/media_src_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/media_src_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/nothing_playing"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/media_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/open_media_hint"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ProgressBar
            android:id="@+id/media_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="10dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="@color/teal"
            android:progressBackgroundTint="@color/glass_stroke" />

        <LinearLayout
            android:id="@+id/media_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/media_prev"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:src="@drawable/ic_prev"
                android:background="@drawable/glass_circle"
                android:padding="2dp"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/media_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/glass_circle"
                android:padding="10dp"
                android:contentDescription="@null" />
            <ImageView
                android:id="@+id/media_next"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:src="@drawable/ic_next"
                android:background="@drawable/glass_circle"
                android:padding="2dp"
                android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
