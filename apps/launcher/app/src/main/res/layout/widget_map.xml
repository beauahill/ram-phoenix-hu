<?xml version="1.0" encoding="utf-8"?>
<!-- Live map card. The Google MapView is added into map_container in code. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_card"
    android:clipToOutline="true">

    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/map_bg" />

    <ImageView
        android:id="@+id/btn_nav"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:padding="9dp"
        android:background="@drawable/glass_circle"
        android:src="@drawable/ic_nav"
        android:contentDescription="@string/navigation" />

    <LinearLayout
        android:layout_width="42dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="14dp"
        android:orientation="vertical"
        android:background="@drawable/glass_pill">
        <TextView
            android:id="@+id/btn_zoom_in"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/zoom_in"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />
        <View
            android:layout_width="24dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/glass_stroke" />
        <TextView
            android:id="@+id/btn_zoom_out"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/zoom_out"
            android:textColor="@color/text_primary"
            android:textSize="22sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="bottom"
        android:layout_margin="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/glass_pill">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_mic"
            android:contentDescription="@null" />
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="14dp"
            android:src="@drawable/ic_search"
            android:contentDescription="@null" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="@string/where_to"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
