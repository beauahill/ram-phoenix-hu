<?xml version="1.0" encoding="utf-8"?>
<!-- One half of SPLIT mode: a slot for the chosen content plus a picker pill on
     the right edge (map / media / drive / app). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pane_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/pane_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/pane_selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="10dp"
        android:orientation="vertical"
        android:padding="4dp"
        android:background="@drawable/glass_pill">
        <ImageView
            android:id="@+id/sel_map"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:background="@drawable/glass_circle"
            android:src="@drawable/ic_map"
            android:contentDescription="@string/pane_map" />
        <ImageView
            android:id="@+id/sel_media"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:padding="9dp"
            android:background="@drawable/glass_circle"
            android:src="@drawable/ic_music"
            android:contentDescription="@string/pane_media" />
        <ImageView
            android:id="@+id/sel_drive"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:padding="9dp"
            android:background="@drawable/glass_circle"
            android:src="@drawable/ic_gauge"
            android:contentDescription="@string/pane_drive" />
        <ImageView
            android:id="@+id/sel_app"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:padding="9dp"
            android:background="@drawable/glass_circle"
            android:src="@drawable/ic_apps"
            android:contentDescription="@string/pane_app" />
    </LinearLayout>
</FrameLayout>
