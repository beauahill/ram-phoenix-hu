<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pane_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg_base" android:clipChildren="true">
    <FrameLayout android:id="@+id/pane_slot" android:layout_width="match_parent"
        android:layout_height="match_parent" android:background="@drawable/glass_card"
        android:clipToOutline="true" android:clipChildren="true" />
    <ImageView android:id="@+id/pane_chevron" android:layout_width="44dp" android:layout_height="44dp"
        android:layout_gravity="top|end" android:padding="11dp"
        android:background="@drawable/glass_circle" android:src="@drawable/ic_m_keyboard_arrow_down"
        android:contentDescription="Choose pane content" />
</FrameLayout>
