<?xml version="1.0" encoding="utf-8"?>
<!-- Dark square tile (reference: VW-style climate page). Selected = lit. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_soft">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#FFFFFFFF" /></shape>
    </item>
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#FF3A3F48" />
                    <stroke android:width="1.5dp" android:color="@color/accent" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape android:shape="rectangle"><corners android:radius="12dp" /><solid android:color="#FF343840" /></shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <solid android:color="#FF22252B" />
                    <stroke android:width="1dp" android:color="#22FFFFFF" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
