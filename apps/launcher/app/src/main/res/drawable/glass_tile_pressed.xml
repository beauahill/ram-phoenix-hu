<?xml version="1.0" encoding="utf-8"?>
<!-- Focused / pressed glass: brighter fill + amber stroke so DPAD focus is obvious. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="@color/glass_fill_bright" />
            <stroke android:width="1.5dp" android:color="@color/glass_stroke_bright" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/glass_highlight"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
