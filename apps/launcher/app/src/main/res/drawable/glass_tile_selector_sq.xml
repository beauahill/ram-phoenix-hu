<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/accent_soft">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_pressed="true" android:drawable="@drawable/glass_tile_pressed_sq" />
            <item android:state_focused="true" android:drawable="@drawable/glass_tile_pressed_sq" />
            <item android:state_selected="true" android:drawable="@drawable/glass_tile_pressed_sq" />
            <item android:drawable="@drawable/glass_tile_sq" />
        </selector>
    </item>
</ripple>
