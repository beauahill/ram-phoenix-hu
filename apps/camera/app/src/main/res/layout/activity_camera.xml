<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Overhead / aux panel (360 mode only): top 16:9 box, height set at runtime -->
    <SurfaceView
        android:id="@+id/surface_aux"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:visibility="gone" />

    <!-- 16:9 letterbox box for the primary feed + guideline overlay.
         Height is computed at runtime (width * 9/16) and gravity is set per
         mode (centered for rear/front, bottom for 360). Prevents the 16:9
         analog feed being stretched to 9:16 on the portrait panel. -->
    <FrameLayout
        android:id="@+id/feed_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center">

        <SurfaceView
            android:id="@+id/surface_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ramphoenix.camera.GuidelineOverlay
            android:id="@+id/guidelines"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- View selector buttons, top-right -->
    <LinearLayout
        android:id="@+id/selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="20dp" />

    <!-- Parking-sensor proximity strip, bottom -->
    <com.ramphoenix.camera.ParkingSensorView
        android:id="@+id/sensors"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:background="#66000000" />

</FrameLayout>
