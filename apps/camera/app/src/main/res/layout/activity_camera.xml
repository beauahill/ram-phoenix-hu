<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Clip the analog buffer to its calibrated picture area in both panels. -->
    <FrameLayout
        android:id="@+id/aux_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:clipChildren="true"
        android:visibility="gone">
        <SurfaceView
            android:id="@+id/surface_aux"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Letterbox box for the primary feed + guideline overlay.
         Height is computed at runtime from the active area of the 720x504 buffer
         and the box is pinned to the top: alone in rear/front, directly under
         the aux feed in 360 (MainActivity.placeFeeds). Prevents the analog
         feed being stretched to 9:16 on the portrait panel. -->
    <FrameLayout
        android:id="@+id/feed_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:clipChildren="true">

        <SurfaceView
            android:id="@+id/surface_main"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.ramphoenix.camera.GuidelineOverlay
            android:id="@+id/guidelines"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/preview_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF080B0F"
            android:gravity="center"
            android:text="Connecting camera…"
            android:textColor="#FFDCE3EA"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium" />
    </FrameLayout>

    <!-- This HAL's SurfaceView can paint beyond a parent's clipped bounds.
         Draw opaque letterboxing after the feed to cover its lower overhang.
         Parking sensors and the optional selector draw above this mask. -->
    <View
        android:id="@+id/feed_mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top"
        android:background="#000000" />

    <!-- View selector buttons, right edge, just below the feed(s); the top
         margin is set at runtime by MainActivity.placeFeeds -->
    <LinearLayout
        android:id="@+id/selector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="vertical"
        android:padding="20dp" />

    <!-- Park-assist display (cluster style), fills the space under the feed -->
    <com.ramphoenix.camera.ParkingSensorView
        android:id="@+id/sensors"
        android:layout_width="match_parent"
        android:layout_height="460dp"
        android:layout_gravity="bottom" />

</FrameLayout>
